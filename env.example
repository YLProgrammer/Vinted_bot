# Copie ce fichier en ".env" (même dossier) et remplis tes vraies valeurs.
# Ne commite JAMAIS le fichier ".env" lui-même (ajoute-le à .gitignore).

CENTRAL_BOT_TOKEN=123456:ton_token_bot_central
SENDER_BOT_TOKEN=123456:ton_token_bot_sender
DEV_BOT_TOKEN=123456:ton_token_bot_dev
DEV_CHAT_ID=ton_chat_id_telegram

# Nom d'utilisateur (sans @) du bot d'alertes, utilisé pour générer les
# liens de parrainage (/parrain). Laisse par défaut si non renseigné.
SENDER_BOT_USERNAME=VintedPulseBot

DB_PATH=vinted_bot.db
TOKENS_FILE=tokens.txt

# --- Optionnel : monitoring externe (ex: https://healthchecks.io) ---
# Laisse vide pour désactiver le heartbeat.
HEALTHCHECK_URL=

# --- Optionnel : réglages avancés (valeurs par défaut si non précisées) ---
# LOG_FILE=vintedpulse.log
# DATA_RETENTION_DAYS=30
# Valeurs par défaut de la plage horaire (modifiable ensuite via /plage sur le bot dev)
# MONITOR_HOUR_START=8
# MONITOR_HOUR_END=23
# REAL_DEAL_THRESHOLD=0.7
# REAL_DEAL_MIN_SAMPLES=5
# REFERRAL_BONUS_DAYS=3
